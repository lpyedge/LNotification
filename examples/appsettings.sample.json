{
  "LNotification": {
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "TimeoutSeconds": 30,
    "Providers": [
      {
        "Provider": "Slack",
        "Alias": "default",
        "WebhookUrl": "https://example.com/slack-webhook"
      },
      {
        "Provider": "Telegram",
        "Alias": "alerts",
        "BotToken": "bot-token",
        "ChatId": "123456"
      },
      {
        "Provider": "Discord",
        "Alias": "devops",
        "WebhookUrl": "https://example.com/discord-webhook"
      },
      {
        "Provider": "Teams",
        "Alias": "teams",
        "WebhookUrl": "https://example.com/teams-webhook"
      },
      {
        "Provider": "Feishu",
        "Alias": "feishu",
        "WebhookUrl": "https://example.com/feishu-webhook"
      },
      {
        "Provider": "Email",
        "Alias": "smtp",
        "SmtpHost": "smtp.example.com",
        "SmtpPort": 587,
        "EnableSsl": true,
        "FromAddress": "noreply@example.com",
        "FromDisplayName": "Notifier",
        "Username": "smtp-user",
        "Password": "smtp-pass",
        "To": [
          "ops@example.com"
        ],
        "Cc": [
          "dev@example.com"
        ],
        "Bcc": [
          "audit@example.com"
        ],
        "SubjectPrefix": "[Notify]"
      },
      {
        "Provider": "Webhook",
        "Alias": "custom-api",
        "Url": "https://my-api.example.com/alert",
        "Method": "POST",
        "Headers": {
          "X-Api-Key": "secret-key",
          "X-Source": "LNotification"
        },
        "BodyTemplate": "{\"text\":\"{message}\",\"severity\":\"{level}\"}"
      },
      {
        "Provider": "Ntfy",
        "Alias": "ntfy",
        "ServerUrl": "https://ntfy.sh",
        "Topic": "my-alerts",
        "Token": "tk_xxxxxxxx",
        "Priority": 4
      },
      {
        "Provider": "Gotify",
        "Alias": "gotify",
        "ServerUrl": "https://gotify.example.com",
        "Token": "A_xxxxxxxx",
        "Priority": 5
      },
      {
        "Provider": "Pushover",
        "Alias": "pushover",
        "ApplicationToken": "axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "UserKey": "uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "Priority": 0,
        "Sound": "pushover"
      },
      {
        "Provider": "Line",
        "Alias": "line",
        "ChannelAccessToken": "xxxxxxxxxxxx...",
        "UserId": "U1234567890abcdef"
      },
      {
        "Provider": "Mattermost",
        "Alias": "mattermost",
        "WebhookUrl": "https://mattermost.example.com/hooks/xxxxxxxx",
        "Channel": "#alerts"
      },
      {
        "Provider": "GoogleChat",
        "Alias": "google-chat",
        "WebhookUrl": "https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN"
      },
      {
        "Provider": "MsGraphEmail",
        "Alias": "office365",
        "TenantId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "ClientId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "ClientSecret": "your-client-secret-value",
        "FromAddress": "noreply@company.com",
        "FromDisplayName": "System Notifier",
        "To": [
          "admin@company.com",
          "ops@company.com"
        ],
        "Cc": [
          "manager@company.com"
        ],
        "Bcc": [
          "audit@company.com"
        ],
        "SubjectPrefix": "[Alert]",
        "SaveToSentItems": false
      }
    ]
  }
}
